{
  "$comment": "Clasificacion de archivos en dominios para el troceo (chunking) del diff. ARTEFACTO CANONICO: adresles-workspace/ai-config/. Editar aqui y re-sincronizar con scripts/sync-ai-config.ps1. El orden de 'domains' importa: gana la primera coincidencia. Globs: '*' = un segmento, '**' = cualquier ruta, '**/' = prefijo opcional.",
  "chunking": {
    "maxChunkLines": 1200,
    "maxFileLines": 600,
    "summarizeOversizedFiles": true
  },
  "repoMarkers": {
    "platform": ["backend/server.py", "backend"],
    "woo": ["adresles.php"]
  },
  "domains": [
    {
      "name": "ai-tooling",
      "repo": "any",
      "priority": "high",
      "globs": [".cursor/**", ".claude/**", "ai-config/**", "openspec/**", "**/CLAUDE.md", "**/CLAUDE.local.md", "**/AGENTS.md", "**/*.mdc"]
    },
    {
      "name": "ci",
      "repo": "any",
      "priority": "low",
      "globs": [".github/**", "**/buildspec*.yml", "**/.gitlab-ci.yml"]
    },
    {
      "name": "docs",
      "repo": "any",
      "priority": "low",
      "globs": ["**/*.md", "**/*.mdc", "memory-bank/**", "docs/**", "**/Prompts/**"]
    },
    {
      "name": "deps",
      "repo": "any",
      "priority": "high",
      "globs": ["**/requirements*.txt", "**/package.json", "**/package-lock.json", "**/yarn.lock", "**/composer.json", "**/composer.lock", "**/pyproject.toml"]
    },
    {
      "name": "config",
      "repo": "any",
      "priority": "high",
      "globs": ["**/.env.example", "**/*.ini", "**/*.cfg", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.json"]
    },
    {
      "name": "tests",
      "repo": "any",
      "priority": "normal",
      "globs": ["**/tests/**", "**/test_*.py", "**/*_test.py", "**/*.test.js", "**/*.test.jsx", "**/__tests__/**", "**/*Test.php", "**/phpunit*.xml"]
    },
    {
      "name": "infra",
      "repo": "any",
      "priority": "high",
      "globs": ["**/Dockerfile*", "**/docker-compose*.yml", "**/*.tf", "aws-migration/**", "**/deploy*.sh", "**/build-client-zip.ps1", "**/webpack.config.js"]
    },
    {
      "name": "scripts",
      "repo": "any",
      "priority": "normal",
      "globs": ["**/*.ps1", "**/*.sh", "**/*.bat"]
    },
    {
      "name": "backend-auth",
      "repo": "platform",
      "priority": "high",
      "globs": ["backend/auth.py", "backend/controllers/auth/**", "backend/services/auth_service.py", "backend/routes/auth*", "backend/utils/audit*"]
    },
    {
      "name": "backend-data",
      "repo": "platform",
      "priority": "high",
      "globs": ["backend/models.py", "backend/database.py"]
    },
    {
      "name": "backend-core",
      "repo": "platform",
      "priority": "high",
      "globs": ["backend/server.py", "backend/config*.py"]
    },
    {
      "name": "backend-webhooks",
      "repo": "platform",
      "priority": "normal",
      "globs": ["backend/controllers/webhooks/**", "backend/routes/webhook*"]
    },
    {
      "name": "backend-api",
      "repo": "platform",
      "priority": "normal",
      "globs": ["backend/controllers/**", "backend/routes/**"]
    },
    {
      "name": "backend-services",
      "repo": "platform",
      "priority": "normal",
      "globs": ["backend/services/**"]
    },
    {
      "name": "backend-misc",
      "repo": "platform",
      "priority": "normal",
      "globs": ["backend/**"]
    },
    {
      "name": "frontend",
      "repo": "platform",
      "priority": "normal",
      "globs": ["frontend/**"]
    },
    {
      "name": "checkout",
      "repo": "woo",
      "priority": "high",
      "globs": ["**/*checkout*", "includes/**checkout**", "assets/**checkout**"]
    },
    {
      "name": "woo-blocks",
      "repo": "woo",
      "priority": "high",
      "globs": ["**/*block*", "includes/**block**", "assets/js/**block**"]
    },
    {
      "name": "plugin-bootstrap",
      "repo": "woo",
      "priority": "high",
      "globs": ["adresles.php", "adresles-config.php", "uninstall.php"]
    },
    {
      "name": "plugin-php",
      "repo": "woo",
      "priority": "normal",
      "globs": ["includes/**"]
    },
    {
      "name": "plugin-js",
      "repo": "woo",
      "priority": "normal",
      "globs": ["assets/js/**", "assets/src/**/*.js", "assets/src/**/*.jsx"]
    },
    {
      "name": "plugin-assets",
      "repo": "woo",
      "priority": "low",
      "globs": ["assets/css/**", "assets/scss/**", "assets/img/**", "assets/**"]
    },
    {
      "name": "i18n",
      "repo": "woo",
      "priority": "low",
      "globs": ["languages/**", "**/*.po", "**/*.pot", "**/*.mo"]
    }
  ],
  "fallbackDomain": "misc"
}
