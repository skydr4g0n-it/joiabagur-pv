{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=joiabagur_pv;Username=postgres;Password=password"
  },
  "Jwt": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "JoiabagurPV",
    "Audience": "JoiabagurPV",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationHours": 8
  },
  // Outbound integration with the jbg-ai service. Development values only.
  //
  // BaseUrl: the .NET API is NOT part of backend/docker-compose.yml — it runs on the
  // host, so it reaches jbg-ai through the port Compose publishes (8001 -> 8000), not
  // through the container name. In production both containers share a user-defined
  // Docker network and the address becomes http://jbg-ai:8000, supplied as the
  // AiGateway__BaseUrl environment variable from SSM (C17).
  //
  // JwtSecret: must match JWT_SECRET of the jbg-ai service in backend/docker-compose.yml
  // literally. Any divergence yields a 401 whose cause the service is required not to
  // disclose. Production reads it from SSM as AiGateway__JwtSecret (C17).
  "AiGateway": {
    "BaseUrl": "http://localhost:8001",
    "JwtSecret": "local-dev-jwt-secret-0123456789abcdef",
    "TokenTtlSeconds": 300,
    "RetrievalTimeoutMs": 800,
    "AssistTimeoutMs": 5000,
    "Enabled": true
  },
  // Service credential for GET /api/ai/index-feed/*. Distinct from Jwt:SecretKey and
  // from AiGateway:JwtSecret. Production reads it from SSM as IndexFeed__ApiKey (C17).
  "IndexFeed": {
    "ApiKey": "local-dev-index-feed-key-0123456789ab",
    "ApiKeyPrevious": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    // The console sink is declared here with NO Args, and each environment file supplies its
    // own: appsettings.Development.json the readable template, appsettings.Production.json the
    // JSON formatter. Two reasons for the split, both learned the hard way:
    //
    //  1. Keyed form, not an array — the configuration provider merges arrays by index, so an
    //     environment override of an array entry lands next to the base entry instead of
    //     replacing it.
    //  2. No Args here — merging is per leaf key, so Args declared at this level would SURVIVE
    //     the environment override and sit alongside it. A console sink offered both an
    //     outputTemplate and a formatter has no single matching overload, and which one Serilog
    //     picks is not something to leave to chance.
    //
    // Declaring the sink itself here (and only the sink) keeps logging alive for any environment
    // without its own file, which would otherwise silently have no sink at all.
    "WriteTo": {
      "console": {
        "Name": "Console"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:3002",
      "http://localhost:3003",
      "http://localhost:5173"
    ]
  },
  "FileStorage": {
    "LocalPath": "uploads",
    "BaseUrl": "/api/files"
  },
  "ModelTraining": {
    "PythonPath": "python",
    "OutputPath": "models",
    "MinPhotosRequired": 10,
    "MinProductsRequired": 2
  }
}