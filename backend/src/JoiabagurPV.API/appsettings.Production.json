{
  // Production logging profile: one JSON object per event, ingestible by an observability
  // platform without parsing free text.
  //
  // The sink itself is declared in appsettings.json; only its arguments live here. Declaring
  // Args in the base file would be fatal rather than untidy: configuration merges per leaf key,
  // so a base outputTemplate would survive this override and the console sink would end up
  // offered both a template and a formatter, with no single overload accepting both.
  "Serilog": {
    "WriteTo": {
      "console": {
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    }
  },
  // Overridden in production by IndexFeed__ApiKey from SSM (C17). The local placeholder
  // must not be the production secret; it is here so the section exists in every
  // appsettings*.json the change lists.
  "IndexFeed": {
    "ApiKey": "local-dev-index-feed-key-0123456789ab",
    "ApiKeyPrevious": ""
  }
}
